# App
# Requests enter through the nginx load balancer on :8080, not the app directly.
# This value is what gets returned in the `short_url` field, so it must match
# the address clients actually use.
BASE_URL=http://localhost:8080
ENVIRONMENT=development

# Postgres
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener
DATABASE_URL=postgresql+psycopg2://shortener:shortener@db:5432/shortener

# Redis
REDIS_URL=redis://cache:6379/0

# Cache
CACHE_TTL_SECONDS=3600

# Rate limiting — applies to POST /api/shorten only (redirects are not limited).
#
# Set high by default so the k6 load test, which creates 20 URLs during setup
# and may be run repeatedly, isn't throttled. Lower it to ~20 if you want to
# demonstrate rate limiting by hand:
#   RATE_LIMIT_REQUESTS=20 docker compose up
RATE_LIMIT_REQUESTS=100000
RATE_LIMIT_WINDOW_SECONDS=60
